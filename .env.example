# Supabase Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to the repository

# Supabase project URL (required for all clients)
SUPABASE_URL=https://quvfkegqgbrvtmufndpn.supabase.co

# Anonymous key for client-side reads (browser React UI)
# This key is safe to expose in browser bundles when RLS is enabled
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key for server-side operations (sync, Streamlit backend)
# NEVER expose this key to browsers or frontend code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
