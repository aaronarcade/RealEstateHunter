{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "property-meta.json",
  "title": "PropertyMeta",
  "description": "Workflow metadata for a property candidate",
  "type": "object",
  "required": ["id", "address", "listing_url", "workflow_state", "created_at", "updated_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable slug identifier"
    },
    "address": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "City, state, etc."
    },
    "listing_url": {
      "type": "string",
      "format": "uri"
    },
    "workflow_state": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "SCREENED",
        "RESEARCHING",
        "READY_FOR_UNDERWRITING",
        "UNDERWRITTEN",
        "AUDIT",
        "RANKED",
        "PUBLISHED"
      ]
    },
    "scout_decision": {
      "type": "string",
      "enum": ["REJECT", "RESEARCH"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
